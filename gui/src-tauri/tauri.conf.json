{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DubFlow",
  "version": "0.3.3",
  "identifier": "com.dubflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DubFlow 视频翻译",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/dubflow-engine",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ]
  }
}
